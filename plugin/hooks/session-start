#!/usr/bin/env bash
set -euo pipefail

# Auto-install or upgrade the tui-canvas binary if the plugin version has changed.
PLUGIN_VERSION=$(cat "${CLAUDE_PLUGIN_ROOT}/VERSION" 2>/dev/null || echo "")
INSTALL_PATH="${HOME}/.local/bin/tui-canvas"
INSTALLED_VERSION=$(tui-canvas version 2>/dev/null || echo "")

if [ -n "$PLUGIN_VERSION" ] && [ "$INSTALLED_VERSION" != "$PLUGIN_VERSION" ]; then
  OS=$(uname -s | tr '[:upper:]' '[:lower:]')
  ARCH=$(uname -m)
  case "$ARCH" in
    x86_64)            ARCH="amd64" ;;
    aarch64 | arm64)   ARCH="arm64" ;;
  esac
  URL="https://github.com/jredville/tui-canvas/releases/download/${PLUGIN_VERSION}/tui-canvas-${OS}-${ARCH}"
  mkdir -p "${HOME}/.local/bin"
  if curl -fsSL "$URL" -o "${INSTALL_PATH}.tmp" 2>/dev/null; then
    chmod +x "${INSTALL_PATH}.tmp"
    mv "${INSTALL_PATH}.tmp" "$INSTALL_PATH"
  fi
fi

NAME=$(basename "$(pwd)")
SOCKET="$HOME/.local/share/tui-canvas/tui.sock"

# Reuse the existing session for this cwd if one exists (e.g. after /clear).
SESSION_ID=""
EXISTING_SESSION=false
if [ -S "$SOCKET" ]; then
  SESSION_ID=$(tui-canvas list --cwd "$(pwd)" 2>/dev/null | tail -1 | cut -f1)
  [ -n "$SESSION_ID" ] && EXISTING_SESSION=true
fi
if [ -z "$SESSION_ID" ]; then
  SESSION_ID=$(uuidgen 2>/dev/null || python3 -c "import uuid; print(uuid.uuid4())")
fi

if [ -S "$SOCKET" ]; then
  printf '{"type":"session_register","session_id":"%s","name":"%s","cwd":"%s"}\n' \
    "$SESSION_ID" "$NAME" "$(pwd)" | tui-canvas send 2>/dev/null || true
  if [ "$EXISTING_SESSION" = true ]; then
    tui-canvas clear "$SESSION_ID" 2>/dev/null || true
  fi
fi

printf '{"hookSpecificOutput":{"additionalContext":"[tui-canvas] Your session ID is: %s"}}\n' "$SESSION_ID"
